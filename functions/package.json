{
  "name": "fireplace-functions",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "engines": { "node": "22" },
  "description": "Sends a content-free push (sender username + 'New Message') when a message is created.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "npm run typecheck && node --test test/*.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
